# VideoForge - Environment Variables for Local Development
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
# For local Docker PostgreSQL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/videoforge
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=videoforge

# ===========================================
# SESSION SECRET
# ===========================================
# Generate a random string (e.g., openssl rand -base64 32)
SESSION_SECRET=your-random-session-secret-key-here

# ===========================================
# AI API KEYS
# ===========================================
# DashScope API (Alibaba Cloud - REQUIRED for video/image generation)
DASHSCOPE_API_KEY=your-dashscope-api-key

# Fal.ai API (optional - for additional AI features)
FAL_KEY=your-fal-api-key

# ===========================================
# LOCAL STORAGE CONFIGURATION
# ===========================================
# Directory for uploaded files (default: ./uploads)
UPLOAD_DIR=./uploads

# Base URL for public asset URLs
APP_BASE_URL=http://127.0.0.1:5000
