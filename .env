# VideoForge - Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_videos
PGHOST=your-database-host
PGPORT=5432
PGUSER=your-database-user
PGPASSWORD=your-database-password
PGDATABASE=your-database-name

# Session Secret (generate a random string)
SESSION_SECRET=your-random-session-secret-key-here
PORT=5000
NODE_ENV=production
MODEL_PATH = 
SESSION_SECRET=Fv33s8jJihmj0l1NTdsfYC+pDpD1cKaTcLUen16vJFfIWSheiUR6AvPg32CqLG6ngZcvDMM7wMMmigAR61DO0A==
# DashScope API (Alibaba Cloud - for Wan AI video/image generation)
DASHSCOPE_API_KEY=sk-89bc9000680141f0bc76a028d0100730

# Fal.ai API (optional - for additional AI features)
FAL_KEY=your-fal-api-key

# Object Storage (Replit managed - automatically configured)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
PUBLIC_OBJECT_SEARCH_PATHS=public
PRIVATE_OBJECT_DIR=.private

# Replit Domain Configuration (automatically set by Replit)
REPLIT_DOMAINS=your-replit-domain.replit.dev
REPLIT_DEV_DOMAIN=your-dev-domain.replit.dev
REPL_ID=your-repl-id

#VITE_WS_URL=ws://localhost:5000/v2
VITE_WS_URL=ws://localhost:5000/v2
UPLOAD_DIR = ./uploads